# Copy to .env and fill in. Never commit the real .env (it's gitignored).
# Every `palimpsest` CLI command (including `palimpsest serve`) loads this
# file automatically on startup -- see cli.py::main(). A key already set in
# your shell's environment always takes precedence over the value here.

# Required only when [backend] name/fallback = "anthropic" in your
# palimpsest.toml. Resolved by the Anthropic SDK -- palimpsest never reads
# a key from a TOML file or CLI flag.
ANTHROPIC_API_KEY=

# Required only when [backend] name/fallback = "gemini" in your
# palimpsest.toml. Resolved by the google-genai SDK -- palimpsest never
# reads a key from a TOML file or CLI flag. GOOGLE_API_KEY also works if
# you already have that set for other Google tooling.
GEMINI_API_KEY=

# --- Dad / China backends (HanBridge fork) ---------------------------------

# Required only when [backend] name/fallback = "workbuddy" (recommended for
# Dad — spends Tencent TokenHub/Token Plan quota, no VPN needed).
# Never commit real values — keep them on Dad's machine only.
WORKBUDDY_API_BASE=
WORKBUDDY_API_KEY=
WORKBUDDY_MODEL=
# Optional tuning:
# WORKBUDDY_TIMEOUT=120
# WORKBUDDY_TEMPERATURE=0.1
# WORKBUDDY_MAX_TOKENS=2000

# Required only when [backend] name/fallback = "baidu" (China-native,
# free 50k chars/day — https://fanyi-api.baidu.com/product/11).
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# Used only when [backend] name/fallback = "ollama" (fully offline —
# requires Ollama running locally, https://ollama.ai).
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5

# Optional: a denylist file (one term per line) used by tools/scrub_check.py
# to catch confidential names/filenames before they're committed. Keep this
# file itself OUTSIDE the repo -- it is disclosive by nature.
PALIMPSEST_DENYLIST=
