# Normalize to LF in the repo regardless of the checkout OS. This project
# is tested on both ubuntu-latest and windows-latest in CI; mixed line
# endings across those runners is a real source of spurious diffs.
* text=auto eol=lf

*.png binary
*.ttf binary
*.otf binary
*.pdf binary

# Windows batch scripts MUST check out as CRLF — CMD.exe fragments LF-only
# bats into garbage. Blobs stay LF (CI-safe); working copies get CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
